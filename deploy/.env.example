# Copy to .env and fill in. .env is gitignored - keep it off the internet.

# Anyone holding this can rewrite the talent trees for every visitor, so make it
# long and random. Generate one with:  openssl rand -base64 30
ADMIN_KEY=

# From Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token.
# Only needed for `--profile tunnel`; leave blank to run on the LAN only.
CLOUDFLARE_TUNNEL_TOKEN=

# LAN port. 8080 is Traefik's on this host and 5500 is paddington's.
PORT=5502

# Suggestions per visitor per hour, and a backstop across everyone.
SUGGEST_PER_IP_PER_HOUR=5
SUGGEST_PER_HOUR=200
